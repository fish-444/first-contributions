# 생성/산출 파일은 재현 가능하므로 버전관리에서 제외.
# (실제 공모전 데이터가 들어오면 아래 예외 규칙을 조정할 것)
__pycache__/
*.pyc

# API 키 등 비밀값 — 절대 커밋 금지
.aihub_key
.env
*.key

# 다운로드한 대용량 AI Hub 데이터
data/aihub/

# Kaggle 다운로드 데이터(라이선스: 재배포 대신 다운로드 스크립트로)
data/edinburgh/
edinburgh_frames.csv
data/*_parsed.csv
data/aihub_71471_frames.csv
# 국내 농장 번식통계 원자료 — 농장 식별자 포함, 집계 JSON 만 커밋.
# 파일명을 하나씩 적으면 새 자료가 들어올 때 샌다. 확장자로 막는다.
*.xlsx

# 실데이터가 임베드된 생성 HTML — 커밋 대신 로컬 생성
dashboard/edinburgh.html
dashboard/posture_gallery.html
dashboard/analysis_report.html
dashboard/behavior_gallery.html
dashboard/detection_viewer.html
dashboard/activity_analysis.html
dashboard/reference_report.html
dashboard/gilt_dashboard.html
dashboard/estrus_timeline.html
dashboard/eval_report.html
dashboard/repro_dashboard.html
dashboard/alert_console.html
# 가중치 전부. models/ 만 막았더니 ultralytics 가 레포 루트로 받은
# yolo11n-seg.pt · yolo11s-seg.pt 26MB 가 그대로 추적됐다.
*.pt
outputs/video_report_*.html
outputs/video_*.webm
data/*.npz
data/work_log.csv

# 서버 DB — 농장 이름·성적은 식별자다. 원자료 스프레드시트를 안 올리는 것과
# 같은 이유로 커밋하지 않는다.
data/farms.db
data/*.db

# 행동 분할 체크포인트 — *.pt 만 막았더니 업로드 체크포인트 확장자 .pth 가
# 그물 밖이었다. onnx 내보내기도 같은 이유로 막는다.
*.pth
*.onnx

# 유튜브 CCTV 실증 자료 — 영상·프레임·라벨·검출 전부 로컬 전용.
# 라벨에 방 식별이, 영상에 저작권이 걸려 있고 저장소는 공개다.
data/cctv/

# 외부 영상 — **제3자 저작물이라 재배포 금지.** 저작권 허락은 분석용이고
# 저장소에 올리는 것은 별개다. 영상·프레임은 빼고, 산출물(검출 JSONL·
# 구성비·대조 결과)만 커밋한다.
data/external/**/*.mp4
data/external/**/*.mov
data/external/**/*.avi
data/external/**/*.mkv
data/external/**/frames/
